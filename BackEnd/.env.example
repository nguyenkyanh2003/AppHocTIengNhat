# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=AppHocTiengNhat

# Server
PORT=3000
NODE_ENV=development
BYPASS_AUTH=false
# Số reverse proxy đứng trước server (Nginx, Render, Railway… thường là 1).
# Bỏ trống khi chạy thẳng trên máy. Sai số này thì giới hạn đăng nhập theo IP
# gộp mọi người làm một, hoặc tin cả X-Forwarded-For giả. Không dùng "true".
TRUST_PROXY=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Password reset email
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=replace-with-an-app-password
# Gốc của link đặt lại mật khẩu. Link được dựng thành
# <FRONTEND_URL>/#/reset-password?token=... vì Flutter Web dùng hash routing,
# nên giá trị này phải trỏ tới nơi bản web đang chạy.
FRONTEND_URL=http://localhost:8080
# Phải chứa đúng origin của bản web ở trên thì trang mới gọi được API.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
