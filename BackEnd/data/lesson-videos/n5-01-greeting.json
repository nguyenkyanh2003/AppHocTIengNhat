    {
      "title": "Tổng hợp lý thuyết: chào hỏi",
      "url": "/uploads/lesson-videos/n5-01-greeting/summary.mp4",
      "source": "つながるひろがる にほんごでのくらし (MEXT)",
      "transcript": [
        {
          "start": "00:06:00",
          "end": "00:08:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "はじめまして。",
          "romaji": "Hajimemashite.",
          "text_vi": "Hân hạnh được làm quen."
        },
        {
          "start": "00:07:00",
          "end": "00:09:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "オウ・ハオランです。",
          "romaji": "Oo haoran desu.",
          "text_vi": "Tôi là Ou Haoran."
        },
        {
          "start": "00:10:00",
          "end": "00:19:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "自己紹介などで、名前を言うとき、名前の後に、「です」をつけます。",
          "romaji": null,
          "text_vi": "Khi nói tên để tự giới thiệu bản thân phải thêm từ “desu” vào sau tên."
        },
        {
          "start": "00:20:00",
          "end": "00:25:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "動画では、「オウ・ハオランです。」と言いました。",
          "romaji": null,
          "text_vi": "Nhân vật trong video đã nói là “Oo Haoran desu. (Tôi là Ou Haoran.)”."
        },
        {
          "start": "00:26:00",
          "end": "00:34:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "AさんがBさんに自分の名前を言うときは、「Aです」と言います。",
          "romaji": null,
          "text_vi": "Khi A nói tên của mình với B, A sẽ nói là “A desu.(Tôi là A.)”."
        },
        {
          "start": "00:36:00",
          "end": "00:43:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "ほかの人の紹介をするときは、その人の名前の後に、「さん」をつけます。",
          "romaji": null,
          "text_vi": "Khi giới thiệu người khác phải thêm từ “san” vào sau tên của người đó."
        },
        {
          "start": "00:51:00",
          "end": "00:53:00",
          "speaker_ja": "先輩社員",
          "speaker_vi": "Nhân viên công ty bậc tiền bối",
          "text_ja": "佐藤です。",
          "romaji": "Satoo desu.",
          "text_vi": "Tôi là Sato."
        },
        {
          "start": "00:52:00",
          "end": "00:54:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "佐藤さんですね。",
          "romaji": "Satoo-san desu ne.",
          "text_vi": "Anh Sato phải không ạ."
        },
        {
          "start": "00:56:00",
          "end": "01:03:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "相手の言ったことを確認したいとき、文の最後に「ね」をつけます。",
          "romaji": null,
          "text_vi": "Khi muốn xác nhận lại nội dung mà đối phương đã nói phải thêm từ “ne” vào cuối câu."
        },
        {
          "start": "01:04:00",
          "end": "01:07:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「トイレはどこですか。」",
          "romaji": null,
          "text_vi": "“Toire wa doko desu ka. (Nhà vệ sinh ở đâu ạ?)”"
        },
        {
          "start": "01:07:00",
          "end": "01:09:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「あそこです。」",
          "romaji": null,
          "text_vi": "“Asoko desu. (Ở đằng kia.)”"
        },
        {
          "start": "01:10:00",
          "end": "01:12:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「あそこですね。」",
          "romaji": null,
          "text_vi": "“Asoko desu ne. (Ở đằng kia phải không ạ.)”"
        },
        {
          "start": "01:13:00",
          "end": "01:30:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "動画の会話では、「佐藤」はほかの人の名前なので「佐藤ですね」ではなく、「佐藤さんですね」と名前に「さん」をつけて言いました。",
          "romaji": null,
          "text_vi": "Trong mẫu hội thoại trên video, “Satoo” là tên của người khác nên nhân vật trong video không nói là “Satoo desu ne. (Sato phải không ạ.)” mà đã thêm từ “san” vào sau tên và nói là “Satoo- san desu ne. (Anh Sato phải không ạ.)”."
        },
        {
          "start": "01:31:00",
          "end": "01:43:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「ね」は、「いい天気ですね。」とか「おいしいですね」のように、相手の共感を求める場合にも使います。",
          "romaji": null,
          "text_vi": "Từ “ne” còn được sử dụng khi muốn thu hút sự đồng cảm của đối phương chẳng hạn như \"Ii tenki desu ne. (Thời tiết đẹp nhỉ.)” hoặc “Oishii desu ne. (Ngon nhỉ.)”."
        },
        {
          "start": "01:50:00",
          "end": "01:52:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "はじめまして。",
          "romaji": "Hajimemashite.",
          "text_vi": "Hân hạnh được làm quen."
        },
        {
          "start": "01:51:00",
          "end": "01:54:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "オウ・ハオランです。",
          "romaji": "Oo haoran desu.",
          "text_vi": "Tôi là Ou Haoran."
        },
        {
          "start": "01:53:00",
          "end": "01:56:00",
          "speaker_ja": "オウ",
          "speaker_vi": "Ou",
          "text_ja": "中国から来ました。",
          "romaji": "Chuugoku kara kimashita.",
          "text_vi": "Tôi đến từ Trung Quốc."
        },
        {
          "start": "01:57:00",
          "end": "02:04:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "自己紹介などで、出身地を言うとき「から来ました」を使います。",
          "romaji": null,
          "text_vi": "Khi nói về nơi xuất thân để tự giới thiệu bản thân, sử dụng mẫu câu “kara kimashita (Tôi đến từ)”."
        },
        {
          "start": "02:05:00",
          "end": "02:14:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「場所」の後に助詞の「から」をつけて、出発点、出発した場所を表します。",
          "romaji": null,
          "text_vi": "Thêm trợ từ “kara” vào sau từ chỉ địa điểm để thể hiện điểm xuất phát, nơi đã xuất phát."
        },
        {
          "start": "02:15:00",
          "end": "02:21:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「来ました」は、「来ます」の過去形です。",
          "romaji": null,
          "text_vi": "Từ “kimashita” là thể quá khứ của từ “kimasu (đến)”."
        },
        {
          "start": "02:23:00",
          "end": "02:29:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "動画では、オウさんが「中国から来ました」と言いました。",
          "romaji": null,
          "text_vi": "Trong video anh Ou đã nói là “Chuugoku kara kimashita. (Tôi đến từ Trung Quốc.)”."
        },
        {
          "start": "02:30:00",
          "end": "02:37:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "ブラジル出身の場合は「ブラジルから来ました」と言います。",
          "romaji": null,
          "text_vi": "Trường hợp xuất thân từ Brazil sẽ nói là “Burajiru kara kimashita. (Tôi đến từ Brazil.)”."
        },
        {
          "start": "02:38:00",
          "end": "02:50:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「から」は場所だけでなく「9時から勉強します」のように時間と一緒に使うこともできます。",
          "romaji": null,
          "text_vi": "Từ “kara (từ)” không chỉ thể hiện địa điểm mà còn có thể sử dụng với thời gian chẳng hạn như “Ku-ji kara benkyoo-shimasu. (Tôi học từ 9 giờ).”."
        },
        {
          "start": "02:50:00",
          "end": "02:53:00",
          "speaker_ja": "ナレーション",
          "speaker_vi": "Lồng tiếng",
          "text_ja": "「9時」が始まりの時間です。",
          "romaji": null,
          "text_vi": "“Kuji (9 giờ)” là giờ bắt đầu."
        }
      ]
    }
  ]
}