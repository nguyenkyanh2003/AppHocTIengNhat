          "key_phrase": false
        },
        {
          "start": "00:30",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "この会話では「静岡に行きたい」と言っていますから、目的地は静岡です。",
          "romaji": "Kono kaiwa de wa \"Shizuoka ni ikitai\" to itte imasu kara, mokutekichi wa Shizuoka desu.",
          "text_vi": "Trong hội thoại này, người khách nói \"muốn đi Shizuoka\" nên điểm đến là Shizuoka.",
          "key_phrase": false
        },
        {
          "start": "00:40",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "「行きたい」は、動詞のます形から「ます」を取って「たい」をつけた形ですが、これは「行く」という行為を希望していることを表します。",
          "romaji": "\"Ikitai\" wa, dooshi no masu-kee kara \"masu\" o totte \"tai\" o tsuketa katachi desu ga, kore wa \"iku\" to iu kooi o kiboo shite iru koto o arawashimasu.",
          "text_vi": "\"Ikitai\" là dạng bỏ \"masu\" ở thể masu rồi thêm \"tai\", diễn tả mong muốn thực hiện hành động \"đi\".",
          "key_phrase": false
        },
        {
          "start": "00:59",
          "speaker_ja": null,
          "speaker_romaji": null,
          "speaker_vi": "Chủ đề",
          "text_ja": "しずおかゆきは なんじですか",
          "romaji": "shizuoka-yuki wa nan-ji desu ka",
          "text_vi": "Chuyến đi Shizuoka mấy giờ ạ?",
          "key_phrase": false
        },
        {
          "start": "01:05",
          "speaker_ja": "男性客",
          "speaker_romaji": "Dansee-kyaku",
          "speaker_vi": "Khách nam",
          "text_ja": "次の静岡行きは何時ですか。",
          "romaji": "Tsugi no Shizuoka-yuki wa nan-ji desu ka.",
          "text_vi": "Chuyến tàu tiếp theo đi Shizuoka lúc mấy giờ ạ?",
          "key_phrase": true
        },
        {
          "start": "01:09",
          "speaker_ja": "駅員",
          "speaker_romaji": "Ekiin",
          "speaker_vi": "Nhân viên nhà ga",
          "text_ja": "10時です。",
          "romaji": "Juu-ji desu.",
          "text_vi": "10 giờ ạ.",
          "key_phrase": false
        },
        {
          "start": "01:12",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "時刻を聞くときは、疑問詞の「なん」に「1時」「2時」の「じ」をつけて、「何時ですか」と聞きます。",
          "romaji": "Jikoku o kiku toki wa, gimonshi no \"nan\" ni \"ichi-ji\", \"ni-ji\" no \"ji\" o tsukete, \"Nan-ji desu ka\" to kikimasu.",
          "text_vi": "Khi hỏi giờ, ghép từ để hỏi \"nan\" với \"ji\" (giờ) như trong \"ichi-ji\", \"ni-ji\" để hỏi \"Nan-ji desu ka\" (Mấy giờ?).",
          "key_phrase": false
        },
        {
          "start": "01:27",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "この会話では、「次の静岡行きは」と言って、静岡に向かう電車の次の発車時刻を聞いています。",
          "romaji": "Kono kaiwa de wa, \"tsugi no Shizuoka-yuki wa\" to itte, Shizuoka ni mukau densha no tsugi no hassha-jikoku o kiite imasu.",
          "text_vi": "Trong hội thoại này, khách nói \"chuyến đi Shizuoka tiếp theo\" để hỏi giờ khởi hành của chuyến tàu tiếp theo đi Shizuoka.",
          "key_phrase": false
        },
        {
          "start": "01:41",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "例えば、ホテルで朝食の時間帯を聞く場合は、「朝食は何時からですか」「何時までですか」のように「から」や「まで」をつけます。",
          "romaji": "Tatoeba, hoteru de chooshoku no jikantai o kiku baai wa, \"Chooshoku wa nan-ji kara desu ka\", \"Nan-ji made desu ka\" no yoo ni \"kara\" ya \"made\" o tsukemasu.",
          "text_vi": "Ví dụ, khi hỏi giờ ăn sáng ở khách sạn thì thêm \"kara\" (từ) hoặc \"made\" (đến): \"Bữa sáng từ mấy giờ?\", \"Đến mấy giờ?\".",
          "key_phrase": false
        },
        {
          "start": "02:00",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "「なん」は、「年」「月」「日」「曜日」「時」「分」「人」「歳」などのほか、いろいろな助数詞につけて使うことができます。",
          "romaji": "\"Nan\" wa, \"nen\", \"gatsu\", \"nichi\", \"yoobi\", \"ji\", \"fun\", \"nin\", \"sai\" nado no hoka, iroiro na josuushi ni tsukete tsukau koto ga dekimasu.",
          "text_vi": "\"Nan\" có thể ghép với nhiều trợ từ đếm như \"nen\" (năm), \"gatsu\" (tháng), \"nichi\" (ngày), \"yoobi\" (thứ), \"ji\" (giờ), \"fun\" (phút), \"nin\" (người), \"sai\" (tuổi)…",
          "key_phrase": false
        },
        {
          "start": "02:19",
          "speaker_ja": null,
          "speaker_romaji": null,
          "speaker_vi": "Chủ đề",
          "text_ja": "みしままで いきたいです",
          "romaji": "mishima made ikitai desu",
          "text_vi": "Tôi muốn đi đến Mishima",
          "key_phrase": false
        },
        {
          "start": "02:24",
          "speaker_ja": "女性客",
          "speaker_romaji": "Josee-kyaku",
          "speaker_vi": "Khách nữ",
          "text_ja": "すみません、三島まで行きたいです。",
          "romaji": "Sumimasen, Mishima made ikitai desu.",
          "text_vi": "Xin lỗi, tôi muốn đi đến Mishima.",
          "key_phrase": true
        },
        {
          "start": "02:29",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "「行く」「来る」「帰る」「着く」などの移動を表す動詞の目的地は、場所に助詞の「に」「へ」をつけるほかに、「まで」をつけて表すこともあります。",
          "romaji": "\"Iku\", \"kuru\", \"kaeru\", \"tsuku\" nado no idoo o arawasu dooshi no mokutekichi wa, basho ni joshi no \"ni\", \"e\" o tsukeru hoka ni, \"made\" o tsukete arawasu koto mo arimasu.",
          "text_vi": "Điểm đến của các động từ di chuyển, ngoài \"ni\", \"e\" còn có thể diễn tả bằng \"made\" (đến).",
          "key_phrase": false
        },
        {
          "start": "02:49",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "その場合、「まで」は最終目的地だけでなく、目的地に向かう途中の地点を示すこともあります。",
          "romaji": "Sono baai, \"made\" wa saishuu-mokutekichi dake de naku, mokutekichi ni mukau tochuu no chiten o shimesu koto mo arimasu.",
          "text_vi": "Khi đó, \"made\" không chỉ chỉ điểm đến cuối cùng mà còn có thể chỉ một điểm giữa đường.",
          "key_phrase": false
        },
        {
          "start": "03:01",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "例えば、三島まで新幹線で行って電車に乗り換えるというような場合です。",
          "romaji": "Tatoeba, Mishima made shinkansen de itte densha ni norikaeru to iu yoo na baai desu.",
          "text_vi": "Ví dụ như đi tàu Shinkansen đến Mishima rồi đổi sang tàu điện.",
          "key_phrase": false
        },
        {
          "start": "03:11",
          "speaker_ja": "ナレーター",
          "speaker_romaji": "Nareetaa",
          "speaker_vi": "Người dẫn",
          "text_ja": "「まで」は場所だけでなく、「夜遅くまで勉強する」のように時間にも使うことができます。",
          "romaji": "\"Made\" wa basho dake de naku, \"yoru osoku made benkyoo suru\" no yoo ni jikan ni mo tsukau koto ga dekimasu.",
          "text_vi": "\"Made\" không chỉ dùng cho nơi chốn mà còn cho thời gian, như \"học đến khuya\".",
          "key_phrase": false
        }
      ]
    }
  ]
}
